# Copy this file to backend/.env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: change which Gemini models answer (tried in order if one is busy or out of quota)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# Optional: store accounts in a Turso database instead of backend/vaidha.db (needed on Vercel, which has no lasting disk)
# TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
# TURSO_AUTH_TOKEN=
