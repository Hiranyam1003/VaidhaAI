# Copy this file to backend/.env and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: change which Groq models answer (tried in order if one is busy or out of quota)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Optional: store accounts in a Turso database instead of backend/vaidha.db (needed on Vercel, which has no lasting disk)
# TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
# TURSO_AUTH_TOKEN=
